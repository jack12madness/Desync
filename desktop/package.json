{
  "name": "desync-desktop",
  "version": "1.0.0",
  "description": "Desync Desktop — Generator + admin snapshot for desync.website",
  "main": "main.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "gg.desync.desktop",
    "productName": "Desync Desktop",
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Desync",
      "artifactName": "DesyncDesktop-Setup.${ext}"
    }
  }
}
